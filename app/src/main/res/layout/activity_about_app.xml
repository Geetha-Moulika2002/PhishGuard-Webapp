<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dark_gradient"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@android:drawable/ic_lock_lock"
        android:layout_marginTop="40dp"
        android:contentDescription="PhishGuard Shield Icon"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PhishGuard Mobile Security"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Version 2.4.0 (Production Build)"
        android:textColor="#38BDF8"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_dark"
        android:padding="20dp"
        android:layout_marginTop="32dp">

        <TextView
            android:id="@+id/tvAboutDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PhishGuard protects users from fraudulent SMS, phishing attempts and malicious QR codes using intelligent on-device analysis."
            android:textColor="#CBD5E1"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:gravity="center"/>

    </LinearLayout>

</LinearLayout>
