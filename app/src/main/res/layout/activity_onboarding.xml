<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dark_gradient"
    android:padding="24dp">

    <!-- Skip Header -->
    <TextView
        android:id="@+id/txtSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Skip"
        android:textColor="#94A3B8"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_gravity="end"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Central Hero Image Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/imgOnboarding"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_lock_lock"
            android:contentDescription="Security Lock Graphic" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Real-Time SMS Defense"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="32dp"/>

        <TextView
            android:id="@+id/txtDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detect phishing links, scam messages, and suspicious SMS activity in real-time using offline AI models."
            android:textColor="#94A3B8"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="4dp"/>

    </LinearLayout>

    <!-- Page Indicator Dots -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:layout_marginBottom="28dp">

        <View
            android:layout_width="28dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_button_primary"/>

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#233256"
            android:layout_marginStart="8dp"/>

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#233256"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <!-- Next Button -->
    <android.widget.Button
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Get Started"
        android:textAllCaps="false"
        android:textSize="17sp"
        android:textStyle="bold"
        android:background="@drawable/bg_button_primary"
        android:textColor="#FFFFFF"/>

</LinearLayout>