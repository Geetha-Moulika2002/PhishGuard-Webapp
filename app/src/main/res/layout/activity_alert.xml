<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#450A0A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvAlertHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨 PHISHGUARD SECURITY ALERT"
            android:textColor="#FCA5A5"
            android:textStyle="bold"
            android:textSize="26sp"
            android:gravity="center"
            android:layout_marginTop="20dp"/>

        <TextView
            android:id="@+id/tvAlertSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BLOCKED SENDER &amp; THREAT INTERCEPTED"
            android:textColor="#FECDD3"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"/>

        <!-- Sender Detail Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#7F1D1D"
            android:padding="20dp"
            android:layout_marginTop="24dp">

            <TextView
                android:id="@+id/tvSenderHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sender: Blocked Scammer"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvRiskScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: 🛡️ Notification Silenced &amp; Message Quarantined"
                android:textColor="#6EE7B7"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- Message Snippet Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#7F1D1D"
            android:padding="20dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Intercepted SMS Content"
                android:textColor="#7DD3FC"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvAlertMessageBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[Message Content Suppressed]"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- Recommended Action Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#7F1D1D"
            android:padding="20dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PhishGuard Protective Action Taken"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ System notification alert suppressed at Priority 999\n✓ SMS broadcast aborted\n✓ Blocked sender logged in PhishGuard Vault"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <android.widget.Button
            android:id="@+id/btnDismissAlert"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="DISMISS SECURITY WARNING"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:textColor="#FFFFFF"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>

</ScrollView>