<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#450A0A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- Dramatic Red Alert Header -->
        <TextView
            android:id="@+id/tvAlertHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨 PHISHGUARD SECURITY ALERT"
            android:textColor="#FCA5A5"
            android:textStyle="bold"
            android:textSize="26sp"
            android:gravity="center"
            android:layout_marginTop="20dp"/>

        <TextView
            android:id="@+id/tvAlertSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BLOCKED SENDER &amp; THREAT INTERCEPTED"
            android:textColor="#FECDD3"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"/>

        <!-- Box 1: Sender Name & Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#7F1D1D"
            android:padding="20dp"
            android:layout_marginTop="28dp">

            <TextView
                android:id="@+id/tvSenderHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sender: Blocked Scammer"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvRiskScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: 🛡️ Blocked Sender (Quarantined)"
                android:textColor="#6EE7B7"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- Box 2: Clean Bold Warning -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#7F1D1D"
            android:padding="24dp"
            android:layout_marginTop="20dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvUserWarningText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚫 DO NOT CLICK ON MESSAGES FROM THIS SENDER!\n\n⚠️ THIS SENDER IS HARMFUL."
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"/>

        </LinearLayout>

        <!-- Dismiss Button -->
        <android.widget.Button
            android:id="@+id/btnDismissAlert"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="DISMISS WARNING"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:textColor="#FFFFFF"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>

</ScrollView>