<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dark_gradient"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QR Code Scanner"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Align QR code within the frame to verify payment URL safety"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:layout_marginTop="4dp"/>

    <!-- Simulated Scanning Frame Container -->
    <LinearLayout
        android:id="@+id/layoutScanning"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_card_dark"
        android:layout_marginTop="40dp">

        <ProgressBar
            android:layout_width="64dp"
            android:layout_height="64dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scanning QR Target..."
            android:textColor="#38BDF8"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

    </LinearLayout>

    <!-- Scanning Result Overlay -->
    <LinearLayout
        android:id="@+id/layoutResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@drawable/bg_card_dark"
        android:padding="20dp"
        android:layout_marginTop="40dp">

        <TextView
            android:id="@+id/tvQrResultStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✅ SAFE QR CODE"
            android:textColor="#10B981"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvQrUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="https://official-merchant.com/pay"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

    <android.widget.Button
        android:id="@+id/btnScanAgain"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Scan Another QR"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/bg_card_dark"
        android:textColor="#38BDF8"
        android:layout_marginTop="32dp"/>

    <android.widget.Button
        android:id="@+id/btnDone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Close Scanner"
        android:textAllCaps="false"
        android:textSize="17sp"
        android:textStyle="bold"
        android:background="@drawable/bg_button_primary"
        android:textColor="#FFFFFF"
        android:layout_marginTop="12dp"/>

</LinearLayout>
