<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dark_gradient"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forgot Password"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your registered email or phone to receive a 6-digit recovery OTP code."
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:layout_marginTop="6dp"/>

    <EditText
        android:id="@+id/etResetContact"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:hint="Email or Phone Number"
        android:textColorHint="#64748B"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_card_dark"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginTop="32dp"/>

    <android.widget.Button
        android:id="@+id/btnSendOtp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Send Recovery OTP"
        android:textAllCaps="false"
        android:textSize="17sp"
        android:textStyle="bold"
        android:background="@drawable/bg_button_primary"
        android:textColor="#FFFFFF"
        android:layout_marginTop="28dp"/>

    <TextView
        android:id="@+id/tvBackToLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back to Sign In"
        android:textColor="#38BDF8"
        android:textSize="14sp"
        android:layout_gravity="center"
        android:padding="12dp"
        android:layout_marginTop="16dp"/>

</LinearLayout>
