<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dark_gradient"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OTP Verification"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter the 6-digit verification code sent to your contact device."
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:layout_marginTop="6dp"/>

    <EditText
        android:id="@+id/etOtp"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:hint="• • • • • •"
        android:inputType="number"
        android:gravity="center"
        android:textColorHint="#64748B"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:letterSpacing="0.3"
        android:background="@drawable/bg_card_dark"
        android:layout_marginTop="32dp"/>

    <android.widget.Button
        android:id="@+id/btnVerifyOtp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Verify Code"
        android:textAllCaps="false"
        android:textSize="17sp"
        android:textStyle="bold"
        android:background="@drawable/bg_button_primary"
        android:textColor="#FFFFFF"
        android:layout_marginTop="28dp"/>

    <TextView
        android:id="@+id/tvResendOtp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Didn't receive code? Resend OTP"
        android:textColor="#38BDF8"
        android:textSize="14sp"
        android:layout_gravity="center"
        android:padding="12dp"
        android:layout_marginTop="16dp"/>

</LinearLayout>
