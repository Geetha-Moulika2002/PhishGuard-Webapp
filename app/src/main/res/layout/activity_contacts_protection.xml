<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvContactsHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contacts Shield Protection"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvContactsSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trusted Whitelist &amp; Emergency Guardian Alert Configuration"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:layout_marginTop="4dp"/>

        <!-- Justification Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="18dp"
            android:layout_marginTop="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 WHY CONTACTS SHIELD IS ESSENTIAL"
                android:textColor="#F59E0B"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Whitelisting family members prevents false positives when receiving transactional money messages.\n2. Configuring an Emergency Guardian automatically alerts your family member if critical coercion or extortion is detected on your phone."
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- Trusted Family Contacts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="18dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trusted Whitelist Contacts"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/layoutTrustedContacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"/>

            <android.widget.Button
                android:id="@+id/btnAddTrustedContact"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="+ Add Trusted Contact"
                android:textAllCaps="false"
                android:textColor="#38BDF8"
                android:textStyle="bold"
                android:background="@drawable/bg_dark_gradient"
                android:layout_marginTop="14dp"/>

        </LinearLayout>

        <!-- Emergency Guardian -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="18dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Emergency Guardian Contact"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvEmergencyContactNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+1 (555) 911-0099"
                android:textColor="#10B981"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <android.widget.Button
                android:id="@+id/btnSetEmergencyGuardian"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Change Emergency Guardian Number"
                android:textAllCaps="false"
                android:textColor="#38BDF8"
                android:textStyle="bold"
                android:background="@drawable/bg_dark_gradient"
                android:layout_marginTop="14dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
