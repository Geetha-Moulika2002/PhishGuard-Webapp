<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dark_gradient"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Blocked Senders &amp; Shield"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Community Auto-Block &amp; Silenced Intrusion Analytics"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:layout_marginTop="2dp"/>

    <!-- FEATURE 1: Community Crowdsourced Auto-Block Shield Banner -->
    <LinearLayout
        android:id="@+id/cardCommunityShield"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_dark"
        android:padding="16dp"
        android:layout_marginTop="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🛡️ Community Auto-Block Shield"
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnToggleCommunityShield"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="ENABLE SHIELD"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_primary"
                android:textColor="#FFFFFF"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvShieldSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto-silences top 100 community-reported fraud senders (SBI-SCAM, HDFCBK-LOAN, KYC traps) before they alert your phone."
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:layout_marginTop="6dp"/>

    </LinearLayout>

    <!-- Audio Siren Alarm Toggle Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_card_dark"
        android:padding="14dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊 PhishGuard Audio Warning Siren"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plays custom audio warning chime when blocked sender texts"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnToggleAudioAlarm"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="ALARM: ON"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:textColor="#FFFFFF"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>

    </LinearLayout>

    <!-- FEATURE 2: Blocked Intrusion Analytics & Silenced Attempts Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="12dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvSilencedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18"
                android:textColor="#10B981"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Silenced Intrusions"
                android:textColor="#94A3B8"
                android:textSize="10sp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="12dp"
            android:gravity="center"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvActiveBlockedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12"
                android:textColor="#38BDF8"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Blocked Senders"
                android:textColor="#94A3B8"
                android:textSize="10sp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Add New Sender Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <EditText
            android:id="@+id/etNewSender"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="Enter phone or header (e.g. AX-BANK)"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:background="@drawable/bg_card_dark"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>

        <android.widget.Button
            android:id="@+id/btnAddBlocked"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Block"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <!-- Search Box -->
    <EditText
        android:id="@+id/etSearchBlocked"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:hint="Search blocked senders..."
        android:textColorHint="#64748B"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:background="@drawable/bg_card_dark"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="10dp"/>

    <!-- Empty State Container -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No blocked senders."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blocked senders will appear here."
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <!-- Blocked List Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:id="@+id/layoutBlockedList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </ScrollView>

</LinearLayout>
