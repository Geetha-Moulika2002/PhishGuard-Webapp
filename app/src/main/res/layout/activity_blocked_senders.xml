<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dark_gradient"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Blocked Senders List"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Manage blocked phone numbers and SMS headers"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:layout_marginTop="4dp"/>

    <!-- Add New Sender Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp">

        <EditText
            android:id="@+id/etNewSender"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Enter phone or header (e.g. AX-BANK)"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="@drawable/bg_card_dark"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"/>

        <android.widget.Button
            android:id="@+id/btnAddBlocked"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Block"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <!-- Search Box -->
    <EditText
        android:id="@+id/etSearchBlocked"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="Search blocked senders..."
        android:textColorHint="#64748B"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:background="@drawable/bg_card_dark"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginTop="12dp"/>

    <!-- Empty State Container -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No blocked senders."
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blocked senders will appear here."
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <!-- Blocked List Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:id="@+id/layoutBlockedList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </ScrollView>

</LinearLayout>
