<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dark_gradient"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Language"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"/>

    <android.widget.Button
        android:id="@+id/btnLangEnglish"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="English (Default)"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_button_primary"
        android:layout_marginTop="24dp"/>

    <android.widget.Button
        android:id="@+id/btnLangHindi"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Hindi (हिंदी)"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_card_dark"
        android:layout_marginTop="12dp"/>

    <android.widget.Button
        android:id="@+id/btnLangSpanish"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Spanish (Español)"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_card_dark"
        android:layout_marginTop="12dp"/>

</LinearLayout>
