<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dark_gradient"
    android:padding="24dp">

    <!-- Header Area -->
    <TextView
        android:id="@+id/tvTimelineHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Activity Timeline"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvTimelineSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PhishGuard Immutable Security Audit Log: Real-time chronological record of every SMS scan, blocked sender, scam report, and permission change."
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="20dp"/>

    <!-- Empty State Container -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgEmptyTimeline"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@android:drawable/ic_menu_recent_history"
            android:contentDescription="Empty Timeline Icon"/>

        <TextView
            android:id="@+id/tvEmptyTimelineTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No activity logged yet."
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/tvEmptyTimelineDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Every SMS scan, threat block, and scam report will appear here."
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <!-- Scrollable Spacious Timeline Container -->
    <ScrollView
        android:id="@+id/scrollTimeline"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/layoutTimelineContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </ScrollView>

</LinearLayout>
